CHUNK_OVERLAP=500
MAX_HISTORY_ITEMS=50
MAX_UPLOAD_MB=50
MAX_DOCUMENT_PAGES=100
MAX_VISION_PAGES=20
MAX_IMAGE_PIXELS=25000000
