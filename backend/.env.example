LOCAL_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_TEXT_MODEL=qwen3.5:2b-q4_K_M
LOCAL_VISION_MODEL=qwen3.5:2b-q4_K_M
LOCAL_MODEL_TIMEOUT=300
LOCAL_MODEL_CONTEXT=8192
LOCAL_MODEL_MAX_TOKENS=256
FAST_WHISPER_MODEL=tiny
